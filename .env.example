# Шаблон переменных окружения LoskCar Tracker.
# Файл .env автоматически НЕ загружается: значения передаются окружением
# процесса (панель платформы, systemd, PowerShell $env:).

# --- Обязательное для production ---
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tracker.example.com
CSRF_TRUSTED_ORIGINS=https://tracker.example.com
# Своё значение ключа webhook: сервис должен отличаться от dev-ключа.
LEAD_API_KEY=generate-long-random-key

# --- База данных (по умолчанию SQLite; для production — PostgreSQL) ---
# DB_ENGINE=postgres
# DB_NAME=loskcar
# DB_USER=loskcar
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

# --- HTTPS за прокси (PaaS/VPS) ---
# Django доверяет заголовку X-Forwarded-Proto от прокси
# DJANGO_TRUST_PROXY=1
# Перенаправление HTTP -> HTTPS на уровне Django
# DJANGO_SSL_REDIRECT=1
# Секунды HSTS (по умолчанию 31536000); 0 отключает
# SECURE_HSTS_SECONDS=31536000

# --- Бизнес-настройки ---
# Вместимость студии (по умолчанию 2)
# WORKSHOP_CAPACITY=2
# Сколько дней показывать выданные заказы на канбане
# ISSUED_VISIBLE_DAYS=7
# Рабочие часы календаря; без них сетка показывает сутки и предупреждает,
# что часы не подтверждены владельцем
# WORKSHOP_OPEN_HOUR=10
# WORKSHOP_CLOSE_HOUR=20
